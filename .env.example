# ==============================================================================
# Handover Environment Variables Configuration
# Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Base URL of the Application
VITE_APP_URL=http://localhost:5173

# API Endpoint URL
VITE_API_BASE_URL=http://localhost:5000

# Error Tracking & Telemetry (Optional in development)
VITE_SENTRY_DSN=

# Institutional Multi-Tenancy Default
VITE_DEFAULT_INSTITUTION_ID=inst-college-1

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Project URL & Publishable Key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Server-Side Supabase Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# PostgreSQL Connection Strings
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
