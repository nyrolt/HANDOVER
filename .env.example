# ==============================================================================
# CampusFlow Environment Variables Configuration
# Copy this file to .env.local for local development. Never commit real secrets.
# ==============================================================================

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Base URL of the Application
VITE_APP_URL=http://localhost:3000

# API Endpoint URL (Leave blank for same-origin relative calls)
VITE_API_BASE_URL=

# Error Tracking & Telemetry (Optional in development)
VITE_SENTRY_DSN=

# Institutional Multi-Tenancy Default
VITE_DEFAULT_INSTITUTION_ID=inst-college-1

